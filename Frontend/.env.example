# Copy to .env.local for local development.
#
# Base URL of the Express API (no trailing slash).
# Demo login (demo@track.io) requires the backend seed: in Backend/, run `npm run seed` (see Backend/README.md).

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Production (frontend on Vercel): set to your public API, no trailing slash, e.g.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# The API must set FRONTEND_ORIGIN to this app's Vercel origin.

# Password reset and invite emails use FRONTEND_ORIGIN on the API (Backend/.env) for links in messages.
# GitHub OAuth is configured on the API (.env there). The app only opens the authorize URL returned by the backend.
