# =============================================================================
# Trackio frontend — environment variables
# =============================================================================
# Copy to Frontend/.env.local for local development. NEVER commit .env files.
#
# Everything prefixed NEXT_PUBLIC_ is baked into the browser bundle at build time and is
# visible to every visitor: never put secrets here (API keys, SMTP, OpenAI, GitHub secrets
# all belong in Backend/.env). Changing a NEXT_PUBLIC_ value requires a rebuild.
#
# ── PRODUCTION CHECKLIST ─────────────────────────────────────────────────────
#  [ ] NEXT_PUBLIC_API_BASE_URL -> public https URL of the API, no trailing slash.
#  [ ] On the API (Backend/.env): FRONTEND_ORIGIN must include this app's exact origin
#      (e.g. https://app.example.com), otherwise login works but every create/update
#      request is rejected with 403 "Request origin not allowed".
#  [ ] Rebuild after changing any value here.
# =============================================================================

# Base URL of the Express API (no trailing slash).
# LOCAL DEV: http://localhost:4000
# PRODUCTION: e.g. https://api.example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Notes:
# - Password reset and invite emails link to the API's FRONTEND_ORIGIN (Backend/.env).
# - GitHub OAuth is configured on the API; the app only opens the authorize URL it returns.
# - Demo login (demo@track.io) needs the backend seed: in Backend/, run `npm run seed`
#   against a local database (see Backend/README.md).
