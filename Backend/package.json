{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "description": "Trackio API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/reset-db.ts",
    "test:transcription": "tsx src/scripts/test-transcription.ts",
    "test:recording": "tsx src/scripts/test-recording.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:secrets": "tsx src/scripts/migrate-secrets.ts",
    "migrate:sort-order": "tsx src/scripts/migrate-sort-order.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.1.1",
    "nodemailer": "^10.6.1",
    "openai": "^6.34.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^3.2.7"
  }
}
