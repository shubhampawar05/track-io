# Copy to .env and fill in. Never commit .env.
#
# MongoDB: use Atlas SRV (recommended) or local:
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/trackio?retryWrites=true&w=majority
# Local alternative:
#   MONGODB_URI=mongodb://127.0.0.1:27017/trackio
#
# Demo data: from Backend/, run `npm run seed` (see README.md).

PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/trackio?retryWrites=true&w=majority
# Required outside NODE_ENV=development/test: random, >= 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-min-32-chars
# Comma-separated list allowed in dev when Next.js falls back to another port (e.g. 3001).
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
# Production (frontend on Vercel): set FRONTEND_ORIGIN to your site origin (e.g. https://app.example.com)
# and API_PUBLIC_URL to the public API URL (e.g. https://api.example.com).
# Optional. Shown in invitation and password reset emails (default: Trackio).
# APP_NAME=Trackio
# Optional. Public base URL for uploaded files in API responses (e.g. http://localhost:4000).
# API_PUBLIC_URL=http://localhost:4000
# Must be exactly "development" or "test" for local insecure defaults; anything else is treated as production-like.
NODE_ENV=development

# Set to true to skip the three getting-started issues on new project creation.
# SKIP_STARTER_ISSUES=true

# --- GitHub OAuth (optional; org-scoped integration from Integrations UI) ---
# Create an OAuth App: GitHub → Settings → Developer settings → OAuth Apps.
# Authorization callback URL must match GITHUB_OAUTH_CALLBACK_URL exactly (backend URL).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/integrations/github/callback
# Min 16 chars; used to encrypt stored tokens. In production, required if GITHUB_CLIENT_ID is set.
# GITHUB_OAUTH_ENCRYPTION_KEY=generate-a-long-random-secret-at-least-16-chars

# --- Email (Nodemailer; optional in dev — reset/invite links print to server console if unset) ---
# SMTP_HOST must be a server hostname (e.g. smtp.gmail.com), NOT your email address — use SMTP_USER for that.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Trackio <noreply@example.com>"
# --- OpenAI transcription extraction (required for transcription -> task extraction) ---
# OPENAI_API_KEY=
# Optional model override (default in code: gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini
# Optional audio transcription model (default in code: gpt-4o-mini-transcribe)
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
