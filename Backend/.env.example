# =============================================================================
# Trackio API — environment variables
# =============================================================================
# Copy to Backend/.env and fill in. NEVER commit .env (it is gitignored).
#
# ── PRODUCTION CHECKLIST (do all of these before deploying) ─────────────────
#  [ ] NODE_ENV=production
#  [ ] JWT_SECRET            -> new random value, >= 32 chars (openssl rand -base64 48).
#                               The API refuses to start with a short or placeholder secret.
#  [ ] MONGODB_URI           -> production database with its OWN user/password
#                               (rotate the password if it was ever shared or committed).
#  [ ] FRONTEND_ORIGIN       -> every deployed frontend URL, comma-separated, exact origin
#                               (scheme + host + port, no path, no trailing slash).
#                               Requests from any other Origin get 403 (CSRF protection).
#  [ ] API_PUBLIC_URL        -> public https URL of this API (used for upload URLs,
#                               webhook URLs and the CSRF allow-list).
#  [ ] TRUST_PROXY           -> number of proxy hops if behind a load balancer / reverse
#                               proxy (usually 1), otherwise every user shares one rate limit.
#  [ ] SMTP_* + MAIL_FROM    -> real mail server, or password reset / invite emails are only
#                               printed to the server log.
#  [ ] OPENAI_API_KEY        -> new key (rotate any key that was shared); needed for
#                               transcription / task extraction.
#  [ ] GITHUB_* (optional)   -> if GitHub integration is used, set all four, including
#                               GITHUB_OAUTH_ENCRYPTION_KEY.
#  [ ] Leave ENABLE_API_DOCS unset (Swagger UI stays off in production).
#  [ ] Never run `npm run seed` or `npm run db:reset` against production (both refuse
#      production / remote databases unless explicitly forced).
#
# Variables NOT used by the code (safe to delete from your .env if present):
#   MONGODB_URI_ATLAS, DB_USERNAME, DB_PASSWORD
# =============================================================================


# ── Runtime ──────────────────────────────────────────────────────────────────
# Must be exactly "development" or "test" to allow insecure local defaults
# (fallback JWT secret, Swagger UI on). Any other value — or unset — is treated as
# production-like. PRODUCTION: production
NODE_ENV=development

# Port the API listens on (integer 1-65535; the API refuses to start otherwise).
PORT=4000

# Set when running behind a reverse proxy / load balancer so client IPs (used for rate
# limiting) are read from X-Forwarded-For. Value = number of proxy hops to trust (e.g. 1).
# Leave unset when clients reach the API directly — then X-Forwarded-For is ignored.
# PRODUCTION: usually 1 behind a load balancer.
# TRUST_PROXY=1


# ── Database ─────────────────────────────────────────────────────────────────
# Atlas SRV (recommended for production) or local MongoDB.
#   Local:  mongodb://127.0.0.1:27017/trackio
#   Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/trackio?retryWrites=true&w=majority
# LOCAL DEV: prefer a local MongoDB — `seed` and `db:reset` refuse remote databases unless
#            you pass --allow-remote=<dbName>.
# PRODUCTION: a dedicated database + user; never share it with development.
MONGODB_URI=mongodb://127.0.0.1:27017/trackio


# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs session cookies (JWT, HS256). Rotating it signs everyone out.
# LOCAL DEV: may be left as the placeholder (a warning is printed).
# PRODUCTION: REQUIRED — random, >= 32 characters, not this placeholder:
#   openssl rand -base64 48
JWT_SECRET=change-me-in-production-min-32-chars


# ── URLs / CORS / CSRF ───────────────────────────────────────────────────────
# Browser origins allowed to call the API (CORS) and to send state-changing requests
# (CSRF Origin check). Comma-separated. The FIRST value is also used for links in emails
# (password reset, invites) and OAuth redirects.
# LOCAL DEV: http://localhost:3000 (add :3001 if Next.js falls back to another port).
# PRODUCTION: e.g. https://app.example.com (add preview/staging URLs if they call this API).
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001

# Public base URL of this API, no trailing slash. Used to build upload/webhook URLs and
# added to the CSRF allow-list (for Swagger UI). Defaults to http://localhost:<PORT>.
# PRODUCTION: REQUIRED, e.g. https://api.example.com
# API_PUBLIC_URL=http://localhost:4000

# Display name in transactional emails (default: Trackio).
# APP_NAME=Trackio

# Swagger UI (/api/docs) and /api/openapi.json. Default: on outside production, off in
# production. Set to true only if you deliberately want public API docs.
# ENABLE_API_DOCS=true


# ── Behaviour ────────────────────────────────────────────────────────────────
# true = skip the three "getting started" issues created with every new project.
# SKIP_STARTER_ISSUES=true


# ── Email (Nodemailer) ───────────────────────────────────────────────────────
# Optional in development: when SMTP_HOST or MAIL_FROM is unset, reset/invite emails are
# printed to the server console instead of being sent.
# PRODUCTION: set all of these. SMTP_HOST is a server hostname (e.g. smtp.gmail.com), NOT
# your email address — that goes in SMTP_USER. For Gmail use an App Password, and rotate it
# if it was ever shared.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true for port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Trackio <noreply@example.com>"


# ── OpenAI (transcription -> task extraction) ────────────────────────────────
# Required for /api/transcriptions/*. Keep it out of the frontend. Each user is limited to
# 30 calls/hour per AI endpoint. Rotate the key if it was ever shared or committed.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini                         # default in code
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe    # default in code


# ── GitHub OAuth (optional; org-scoped integration from the Integrations page) ──
# Create an OAuth App: GitHub -> Settings -> Developer settings -> OAuth Apps.
# The app's "Authorization callback URL" must equal GITHUB_OAUTH_CALLBACK_URL exactly.
# PRODUCTION: set all four or none.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/integrations/github/callback
# Encrypts stored GitHub access tokens (AES-256-GCM). Min 16 chars; use a long random value
# (openssl rand -base64 48). REQUIRED in production when GITHUB_CLIENT_ID is set.
# Do not change it once tokens are stored: existing connections would need to reconnect.
# GITHUB_OAUTH_ENCRYPTION_KEY=
